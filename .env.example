# Local app port
PORT=5000

# Local PostgreSQL connection string
# Default credentials match docker-compose.yml in this repo
DATABASE_URL=postgresql://dnd_user:dnd_pass@localhost:5432/dnd_board

# Shared code required to enter this campaign instance
CAMPAIGN_ACCESS_CODE=replace-with-a-private-code

# Session cookie signing secret (host-only; set a long random value)
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: override default account passwords server-side
# ACCOUNT_PASSWORD_TIEN=your-password
# ACCOUNT_PASSWORD_MARLIN=your-password
# ACCOUNT_PASSWORD_NICO=your-password
# ACCOUNT_PASSWORD_AMBROSE=your-password
# ACCOUNT_PASSWORD_DM=your-password
